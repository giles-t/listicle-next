# Copy this file to .env.local and fill in your actual values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Email Service (Optional - for sending emails)
RESEND_API_KEY=your-resend-api-key

# Error Monitoring (Optional - for production)
# SENTRY_DSN is used by the server/edge runtimes and the build pipeline.
# NEXT_PUBLIC_SENTRY_DSN is required for client-side error capture - Next.js
# only inlines env vars prefixed with NEXT_PUBLIC_ into the browser bundle.
# In most cases both should be set to the same DSN.
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Embed Service (Required for URL embeds)
IFRAMELY_API_KEY=your-iframely-api-key

# OpenAI Configuration (Required for AI features)
OPENAI_API_KEY=your-openai-api-key

# Vercel Blob Storage (Required for image uploads)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Upstash Redis via Vercel KV (Required for caching reactions, view counts, and rate limiting)
# These are auto-populated by the Vercel <> Upstash integration — do not rename.
# The server reads KV_REST_API_URL / KV_REST_API_TOKEN in src/server/redis.ts; the
# older UPSTASH_REDIS_REST_* names are ignored and Redis silently degrades to no-op.
KV_REST_API_URL=https://your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-rest-api-token

# Vercel Cron (Required for view count sync in production)
CRON_SECRET=your-random-cron-secret

# Logging (Optional)
LOG_LEVEL=info
NODE_ENV=development 